# Copy to .env.cloud on the server; never copy the Windows .env/proxy files.
APP_NAME=安巡智脑
ENVIRONMENT=production
APP_TIMEZONE=Asia/Shanghai
CLOUD_BIND_IP=0.0.0.0
CLOUD_HTTP_PORT=80

# One HTTP Basic login protects pages, reads, writes, media and reports.
DEMO_USER=judge
DEMO_PASSWORD=
API_KEY=
CORS_ORIGINS=http://localhost

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_REQUIRED=false

VISION_LLM_ENABLED=true
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_MODEL=qwen3-vl-plus
VISION_LLM_API_KEY=
VISION_LLM_TIMEOUT_SECONDS=60
VISION_LLM_USE_OUTBOUND_PROXY=true
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=15

YOLO_DEFAULT_CONF=0.30
YOLO_REVIEW_CONF=0.50
GENERAL_YOLO_DEFAULT_CONF=0.20
GENERAL_YOLO_REVIEW_CONF=0.35
GENERAL_YOLO_CLASSES=person,bicycle,car,motorcycle,bus,truck
CROWD_MIN_PERSONS=8
EMBEDDING_DIMENSION=384
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.08

# CPU demo resource tuning, not a different tracking feature.
VIDEO_MAX_UPLOAD_MB=100
VIDEO_MAX_FRAMES=300
VIDEO_FRAME_STRIDE=2
VIDEO_TARGET_FPS=5
VIDEO_MAX_DIMENSION=640
WRONG_WAY_MIN_TRACK_POINTS=8
WRONG_WAY_MIN_DISPLACEMENT_RATIO=0.03
