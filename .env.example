# 应用
APP_NAME=安巡智脑
ENVIRONMENT=production
API_KEY=
CORS_ORIGINS=http://localhost:8080
# 仪表盘“今日巡检”和近 7 日趋势的日期边界（IANA 时区名；容器默认 UTC）
APP_TIMEZONE=Asia/Shanghai

# 可选：VPN/Clash/Mihomo 的本机 HTTP 代理。普通直连环境保持为空。
# 本地示例：http://127.0.0.1:7890
# Docker 示例通过 DOCKER_OUTBOUND_HTTP_PROXY 使用：http://host.docker.internal:7890
OUTBOUND_HTTP_PROXY=
DOCKER_OUTBOUND_HTTP_PROXY=

# 数据库（本地直接运行可改成 sqlite:///./data/campus_safety.db）
MYSQL_DATABASE=campus_safety
MYSQL_USER=campus
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql+pymysql://campus:change-me@mysql:3306/campus_safety?charset=utf8mb4

# YOLO26：必须指向 TT100K 正式训练后的权重
YOLO_MODEL_PATH=/app/models/yolo26-tt100k-best.pt
YOLO_DEVICE=cpu
DOCKER_YOLO_DEVICE=cpu

# 旁挂视觉证据；样例不默认联网，实际 .env 显式启用并配置本提供方密钥。
# 不要把 DeepSeek 密钥用于百炼；这些字段仅由服务器读取。
VISION_LLM_ENABLED=false
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_MODEL=qwen3-vl-plus
VISION_LLM_API_KEY=
# 默认继承 OUTBOUND_HTTP_PROXY，包含百炼；false 强制直连。
# 代理为空时仍直连，不根据提供方名称猜测网络可达性。
VISION_LLM_USE_OUTBOUND_PROXY=true
YOLO_DEFAULT_CONF=0.30
YOLO_REVIEW_CONF=0.50
YOLO_DEFAULT_IOU=0.50
YOLO_DEFAULT_IMGSZ=640
ULTRALYTICS_CONFIG_DIR=./data/ultralytics

# 官方 COCO 80 类 YOLO26：系统仅采纳人员和车辆白名单，避免干扰交通标志模型
GENERAL_YOLO_ENABLED=true
GENERAL_YOLO_MODEL_PATH=/app/models/yolo26m.pt
GENERAL_YOLO_DEFAULT_CONF=0.20
GENERAL_YOLO_REVIEW_CONF=0.35
GENERAL_YOLO_CLASSES=person,bicycle,car,motorcycle,bus,truck
CROWD_DETECTION_ENABLED=true
CROWD_MIN_PERSONS=8

# 视频轨迹分析：ByteTrack + 聚集/逆行规则
VIDEO_MAX_UPLOAD_MB=100
VIDEO_MAX_FRAMES=900
VIDEO_FRAME_STRIDE=2
VIDEO_TARGET_FPS=10
VIDEO_MAX_DIMENSION=960
WRONG_WAY_MIN_TRACK_POINTS=8
WRONG_WAY_MIN_DISPLACEMENT_RATIO=0.03

# Qdrant / RAG
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=campus_safety_knowledge
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=384
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.08

# DeepSeek V4 Flash：接口和模型已预设，实际部署只需填写 LLM_API_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_REQUIRED=false

# 高德 Web 服务 Key（仅保存在服务端，不进入前端构建）
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=10
