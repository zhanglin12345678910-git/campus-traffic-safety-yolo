# Copy this file to .env or set these variables in your shell.
# Keep API_KEY private. This example value is not a real secret.

APP_NAME=安巡智脑
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
API_KEY=replace-me

# Prefer setting this explicitly when you replace the model later.
# The current code can also fall back to known repository best.pt candidates.
YOLO_MODEL_PATH=runs/train/TT100K-增强-yolo11-第一个实验-newt100k2/weights/best.pt
YOLO_DEVICE=0
YOLO_DEFAULT_IMGSZ=640
YOLO_DEFAULT_CONF=0.30
YOLO_DEFAULT_IOU=0.50

OUTPUT_DIR=outputs/detections

