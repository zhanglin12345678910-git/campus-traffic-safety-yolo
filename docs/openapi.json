{
  "openapi": "3.1.0",
  "info": {
    "title": "安巡智脑 - 交通标志检测 API",
    "description": "交通标志检测服务，支持图片上传和 YOLO 推理，返回结构化检测结果和标注结果图。",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "本地开发服务器"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "健康检查",
        "description": "检查 API 服务状态和模型配置。无需鉴权。",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/current": {
      "get": {
        "summary": "当前模型信息",
        "description": "查看当前模型路径和默认推理参数。",
        "operationId": "currentModel",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/detect/image": {
      "post": {
        "summary": "图片检测",
        "description": "上传一张图片，返回交通标志检测结果和标注结果图。",
        "operationId": "detectImage",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DetectImageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "检测成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectImageResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求无效（图片解码失败、格式不支持、尺寸太小等）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "API Key 错误或缺失",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "请求参数验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "500": {
            "description": "服务端错误（模型加载失败、推理失败等）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/outputs/detections/{filename}": {
      "get": {
        "summary": "获取检测结果图片",
        "description": "根据文件名获取标注后的检测结果图片。",
        "operationId": "getResultImage",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "结果图片文件名"
          }
        ],
        "responses": {
          "200": {
            "description": "图片文件",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "文件不存在"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API 鉴权密钥，通过环境变量 API_KEY 配置"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "app_name": {
            "type": "string",
            "example": "安巡智脑"
          },
          "model_path": {
            "type": "string",
            "nullable": true,
            "example": "runs/train/TT100K-增强-yolo11-第一个实验-newt100k2/weights/best.pt"
          },
          "model_exists": {
            "type": "boolean",
            "example": true
          },
          "device": {
            "type": "string",
            "example": "0"
          },
          "load_count": {
            "type": "integer",
            "example": 0,
            "description": "模型已加载次数（同进程内应为 1）"
          }
        }
      },
      "ModelInfoResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "model_path": {
                "type": "string",
                "nullable": true
              },
              "model_exists": {
                "type": "boolean"
              },
              "device": {
                "type": "string"
              },
              "img_size": {
                "type": "integer",
                "example": 640
              },
              "conf_threshold": {
                "type": "number",
                "example": 0.3
              },
              "iou_threshold": {
                "type": "number",
                "example": 0.5
              }
            }
          }
        }
      },
      "DetectImageRequest": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "图片文件（支持 jpg/jpeg/png/bmp/webp）"
          },
          "location": {
            "type": "string",
            "nullable": true,
            "description": "拍摄地点描述，如"北门入口""
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "备注信息，如"早班巡检""
          }
        }
      },
      "DetectImageResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "是否检测成功"
          },
          "task_id": {
            "type": "string",
            "description": "本次请求的唯一 ID（UUID hex）",
            "example": "f1f6b68fd9f94420a39c67c58c9a3f2a"
          },
          "image": {
            "$ref": "#/components/schemas/ImageInfo"
          },
          "model": {
            "$ref": "#/components/schemas/ModelConfig"
          },
          "detections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Detection"
            },
            "description": "检测到的目标列表"
          },
          "object_count": {
            "type": "integer",
            "description": "检测到的目标总数",
            "example": 2
          },
          "review_required": {
            "type": "boolean",
            "description": "是否需要人工复核"
          },
          "review_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "需要复核的原因列表"
          },
          "result_image_url": {
            "type": "string",
            "nullable": true,
            "description": "标注结果图的相对 URL，需拼接服务器地址",
            "example": "/outputs/detections/road-a1b2c3d4.jpg"
          },
          "timing": {
            "$ref": "#/components/schemas/Timing"
          },
          "location": {
            "type": "string",
            "nullable": true,
            "description": "用户传入的拍摄地点（原样返回）"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "用户传入的备注（原样返回）"
          },
          "error": {
            "type": "object",
            "nullable": true,
            "description": "错误信息（成功时为 null）"
          }
        }
      },
      "ImageInfo": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "nullable": true,
            "description": "原始上传文件名"
          },
          "width": {
            "type": "integer",
            "description": "图片宽度（像素）",
            "example": 640
          },
          "height": {
            "type": "integer",
            "description": "图片高度（像素）",
            "example": 480
          },
          "channels": {
            "type": "integer",
            "description": "图片通道数",
            "example": 3
          }
        }
      },
      "ModelConfig": {
        "type": "object",
        "properties": {
          "weights": {
            "type": "string",
            "nullable": true,
            "description": "模型权重文件名（仅文件名，不含路径）",
            "example": "best.pt"
          },
          "device": {
            "type": "string",
            "nullable": true,
            "description": "推理设备",
            "example": "0"
          },
          "img_size": {
            "type": "integer",
            "nullable": true,
            "description": "推理输入尺寸",
            "example": 640
          },
          "conf_threshold": {
            "type": "number",
            "nullable": true,
            "description": "置信度阈值",
            "example": 0.3
          },
          "iou_threshold": {
            "type": "number",
            "nullable": true,
            "description": "IoU 阈值",
            "example": 0.5
          }
        }
      },
      "Detection": {
        "type": "object",
        "properties": {
          "class_id": {
            "type": "integer",
            "description": "类别 ID",
            "example": 1
          },
          "class_name": {
            "type": "string",
            "description": "类别名称",
            "example": "stop"
          },
          "confidence": {
            "type": "number",
            "description": "置信度（0~1）",
            "example": 0.94
          },
          "box_xyxy": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "边界框坐标 [x1, y1, x2, y2]",
            "example": [100.0, 200.0, 300.0, 400.0]
          }
        }
      },
      "Timing": {
        "type": "object",
        "properties": {
          "elapsed_ms": {
            "type": "number",
            "nullable": true,
            "description": "推理耗时（毫秒）",
            "example": 45.67
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [false]
          },
          "message": {
            "type": "string",
            "description": "错误描述"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "错误代码",
                "enum": [
                  "invalid_image",
                  "invalid_api_key",
                  "model_not_configured",
                  "model_load_failed",
                  "prediction_failed"
                ]
              }
            }
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": ["loc", "msg", "type"],
        "properties": {
          "loc": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "integer" }
              ]
            }
          },
          "msg": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    }
  }
}
